# Keep false in normal usage. Set true only for an authorized local/private lab.
ALLOW_PRIVATE_TARGETS=false
REQUEST_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=100000

# Change these before exposing the dashboard beyond your own machine.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
APP_SECRET=replace-with-a-long-random-secret
TOKEN_TTL_SECONDS=28800

# Optional: PostgreSQL example
# DATABASE_URL=postgresql+psycopg://aegis:password@postgres:5432/aegis
